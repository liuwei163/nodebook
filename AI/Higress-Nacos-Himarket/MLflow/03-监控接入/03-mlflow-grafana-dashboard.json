{
  "title": "MLflow 平台监控",
  "uid": "mlflow-ops",
  "tags": ["mlflow", "ai-platform"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "服务状态 mlflow_up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "mlflow_up", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "数据盘水位（/data NFS PV）",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "mlflow_disk_used_ratio", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.85 },
              { "color": "dark-red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "活跃实验总数",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "mlflow_experiments_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "模型版本总数",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "mlflow_model_versions_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "数据盘使用量（used / total）",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "mlflow_disk_used_bytes", "refId": "A", "legendFormat": "已用" },
        { "expr": "mlflow_disk_total_bytes", "refId": "B", "legendFormat": "总量" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Run 总量趋势",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "mlflow_runs_total", "refId": "A", "legendFormat": "活跃 run" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Run 状态分布（错误/流量信号）",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "mlflow_runs_by_status", "refId": "A", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "探活延迟（/health 合成探针）",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 8 },
      "targets": [{ "expr": "mlflow_health_probe_duration_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "24h 新增模型版本",
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "mlflow_model_versions_created_24h", "refId": "A" }]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "平均训练时长",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [{ "expr": "mlflow_run_duration_seconds_avg", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
